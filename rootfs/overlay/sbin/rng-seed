#!/bin/sh
# Wait for CRNG initialization before OpenRC's dep-cache uses getrandom(). The built-in
# OMAP driver registers a 900/1024-quality hwrng, and Linux's hwrng thread feeds and
# credits it to the kernel pool without a userspace daemon.
mount -t proc proc /proc 2>/dev/null
dd if=/dev/random of=/dev/null bs=1 count=1 2>/dev/null
