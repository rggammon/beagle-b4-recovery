#!/bin/sh
### BEGIN INIT INFO
# Provides:          kiosk
# Required-Start:    $local_fs $remote_fs powervr
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Graphical app launcher on tty7
### END INIT INFO

# Inactive until a launcher is installed.
[ -x /usr/local/bin/kiosk-launcher ] || exit 0

case "${1:-}" in
    start) /usr/local/bin/kiosk start ;;
    stop) /usr/local/bin/kiosk stop ;;
    restart|force-reload)
        /usr/local/bin/kiosk stop
        sleep 3
        /usr/local/bin/kiosk start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload}" >&2
        exit 1
        ;;
esac
